{
  "name": "@core-ds/docs-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "typography:tokens": "node scripts/generate-typography-tokens.mjs",
    "palette:tokens": "node scripts/generate-theme-palette.mjs",
    "dev": "npm run typography:tokens && npm run palette:tokens && vite",
    "build": "npm run typography:tokens && npm run palette:tokens && tsc -b && vite build",
    "preview": "vite preview --port 4173"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "sass": "^1.104.1",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
